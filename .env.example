# Required for live flyer/email extraction; chat has a grounded offline fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional semantic ranking; blank uses deterministic personalization.
GEMMA_MODEL=
EVENTS_JSON_PATH=data/sample_announcements.json
DATABASE_URL=file:./uniradar.db
PORT=3000
COOKIE_MODE=local
SESSION_TTL_HOURS=24
PYTHON_API_URL=http://127.0.0.1:8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
VITE_USE_MOCKS=false
