# Google Gemini API key for multimodal extraction and trilingual advisor
GEMINI_API_KEY="your api key"

# Optional: Default model config
GEMINI_MODEL=gemini-3-flash-preview


DATABASE_URL="file:../dev.db"
PORT=3000
SESSION_TTL_HOURS=24
# Local HTTP: lax + not secure. For embedded HTTPS Preview, set COOKIE_MODE=preview.
COOKIE_MODE=local
# Comma-separated exact origins allowed for cross-origin requests; same-origin UI/API needs no CORS exception.
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
# Frontend-only setting: demo providers are clearly labelled. Set false when teammate APIs are available.
VITE_USE_MOCKS=true
# Optional browser-safe API origin. Do not put credentials or secrets here.
VITE_API_BASE_URL=